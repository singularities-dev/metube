{
  "name": "metube",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "User-driven video curation: listings by your preferences, tags, mood and ratings.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "predev": "node -e \"require('fs').mkdirSync('.dev-profiles/firefox',{recursive:true})\"",
    "predev:firefox": "node -e \"require('fs').mkdirSync('.dev-profiles/firefox',{recursive:true})\"",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "idb": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
